# Set this when you want the app to resolve bucket-relative media paths.
# Example: https://judge-tape-media.<account-id>.r2.dev
VITE_MEDIA_BASE_URL=

# Set this only when your Cloudflare Worker API is ready.
VITE_MEDIA_API_BASE_URL=

# Use 'demo' for the current sample videos while the real media API is being built.
VITE_MEDIA_MODE=demo
